{
  "mcpServers": {
    "pacer": {
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "--no-dev",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}",
        "pacer",
        "serve"
      ],
      "env": {
        "UV_PROJECT_ENVIRONMENT": "${CLAUDE_PLUGIN_DATA}/venv",
        "UV_CACHE_DIR": "${CLAUDE_PLUGIN_DATA}/uv-cache",
        "UV_PYTHON_DOWNLOADS": "never"
      }
    }
  }
}
