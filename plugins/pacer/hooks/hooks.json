{
  "description": "PACER frames at session start, on a prompt that names a card, before and after edits, and at stop.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --no-python-downloads --python \">=3.11\" \"${CLAUDE_PLUGIN_ROOT}/src/pacer/__main__.py\" hook session-start",
            "commandWindows": "uv run --no-project --no-python-downloads --python \">=3.11\" \"$env:PLUGIN_ROOT/src/pacer/__main__.py\" hook session-start",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --no-python-downloads --python \">=3.11\" \"${CLAUDE_PLUGIN_ROOT}/src/pacer/__main__.py\" hook prompt",
            "commandWindows": "uv run --no-project --no-python-downloads --python \">=3.11\" \"$env:PLUGIN_ROOT/src/pacer/__main__.py\" hook prompt",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --no-python-downloads --python \">=3.11\" \"${CLAUDE_PLUGIN_ROOT}/src/pacer/__main__.py\" hook pre-edit",
            "commandWindows": "uv run --no-project --no-python-downloads --python \">=3.11\" \"$env:PLUGIN_ROOT/src/pacer/__main__.py\" hook pre-edit",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|apply_patch|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --no-python-downloads --python \">=3.11\" \"${CLAUDE_PLUGIN_ROOT}/src/pacer/__main__.py\" hook post-edit",
            "commandWindows": "uv run --no-project --no-python-downloads --python \">=3.11\" \"$env:PLUGIN_ROOT/src/pacer/__main__.py\" hook post-edit",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --no-python-downloads --python \">=3.11\" \"${CLAUDE_PLUGIN_ROOT}/src/pacer/__main__.py\" hook stop",
            "commandWindows": "uv run --no-project --no-python-downloads --python \">=3.11\" \"$env:PLUGIN_ROOT/src/pacer/__main__.py\" hook stop",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
