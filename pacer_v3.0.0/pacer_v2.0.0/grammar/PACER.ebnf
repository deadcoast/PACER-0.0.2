file        = header, project, modulation?, global+, end ;
header      = "PACER::TODO", "version=", value ;
project     = "PROJECT", string, attribute* ;
modulation  = "MODULATION", string ;
global      = "GLOBAL", id, string, attribute*, item* ;
item        = source | phase | loop | overlord | nodule | approval | absorption | gate | conditional ;
source      = "SOURCE", string, attribute* ;
phase       = "PHASE", id, string, attribute*, pace*, exit? ;
pace        = "PACE", id, string, attribute* ;
exit        = "EXIT", attribute+ ;
loop        = ":loop⠁:" ;
overlord    = "OVERLORD", attribute+ ;
nodule      = ":nodule", id, string, attribute* ;
approval    = "+approved", id ;
absorption  = "->:absorb::nodule", id, attribute* ;
gate        = "GATE", id, attribute* ;
conditional = "?if", attribute+ ;
attribute   = key, "=", value ;
id          = letter, { letter | digit | "." | "-" | "_" } ;
key         = id ;
value       = string | id ;
string      = '"', { ? any character except quote ? }, '"' ;
end         = "END" ;
